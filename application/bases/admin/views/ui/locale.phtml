<?php

use Jet\UI_flag;
use Jet\MVC_View;

/**
 * @var MVC_View $this
 * @var UI_flag $f
 */
$f = $this->getRaw( 'element' );


$title = $f->getLocale()->getRegionName() . ' - ' . $f->getLocale()->getLanguageName();
$region = strtolower( $f->getLocale()->getRegion() );

$f->setBaseCssClass('flag flag-'.$region);
$f->setCustomTagAttribute('title', $title);
// Decorative: the language name right after it already says the same thing.
$f->setCustomTagAttribute('aria-hidden', 'true');

?>
<span <?=$f->renderTagAttributes()?> ></span> <?= $f->getLocale()->getLanguageName() ?>