<?php

use Jet\UI_icon;
use Jet\UI_tree;
use Jet\UI;
use Jet\Data_Tree_Node;
use Jet\MVC_View;

/**
 * @var MVC_View $this
 * @var UI_tree $tree
 */
$tree = $this->getRaw( 'element' );

$icon_width = 22;
$icon_size = UI_icon::SIZE_SMALL;
?>
<div class="tree">
	<?php foreach( $tree->getData() as $node ):

		/**
		 * @var Data_Tree_Node $node
		 */

		if( !$node->getIsRoot() && !$tree->nodeFilter( $node ) ) {
			continue;
		}

		$display_callback = $tree->getNodeRenderer( $node );

		$icon = 'file';
		$aria_expanded = '';
		if( $node->getHasChildren() ) {
			if( $tree->nodeOpened( $node ) ) {
				$icon = 'folder-open';
			} else {
				$icon = 'folder';
			}
			// The icon alone (now aria-hidden, like every icon) no longer carries this
			// state to assistive tech, so expose it explicitly here instead.
			$aria_expanded = $tree->nodeOpened( $node ) ? ' aria-expanded="true"' : ' aria-expanded="false"';
		}


		$padding = ($node->getDepth()) * $icon_width;
		?>
		<?php $is_selected = $tree->getSelectedId() == $node->getId(); ?>
		<div class="tree-row-container">
			<div class="tree-row<?= $is_selected ? ' selected' : '' ?>"<?= $is_selected ? ' aria-current="true"' : '' ?><?= $aria_expanded ?>>
				<div class="tree-row-icon-container" style="padding-left: <?= $padding; ?>px;">
					<?= UI::icon( $icon )->setSize( $icon_size )?>
				</div>
				<div class="tree-row-node-container"><?= $display_callback( $node, $node->getData() ); ?></div>
			</div>
		</div>

	<?php endforeach; ?>
</div>


