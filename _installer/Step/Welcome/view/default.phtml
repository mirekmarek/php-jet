<?php

namespace JetApplication\Installer;

use Jet\Data_Text;
use Jet\MVC_View;
use Jet\Tr;
use Jet\UI;

/**
 * @var MVC_View $this
 */
?>


<ul style="list-style: none;margin: 0;padding: 0;">
<?php foreach( Installer::getAvailableInstallerLocales() as $locale ): ?>
	<li style="padding: 10px; display: flex;align-items: center;gap: 10px;">
		<div style="font-size: 1.6rem">
			<?= UI::flag( $locale ) ?>
		</div>
		<div>
			<b><?= $locale->getLanguageName( $locale ) ?></b>
			<br/>
			<?php
			$choose_text = Tr::_(
				text: 'Please choose your language',
				dictionary: Installer::getCurrentStepName(),
				locale: $locale
			);
			?>
			<?php
			// The visible text alone ("Please choose your language") is identical on every
			// item in this list, so the accessible name needs the language name too to tell
			// them apart - but it must still *start* with the same words as the visible text,
			// or voice-control commands like "click Please choose your language" stop matching
			// (WCAG 2.5.3 Label in Name).
			?>
			<a href="?locale=<?= $locale ?>" style="text-decoration: underline"
			   aria-label="<?= Data_Text::htmlSpecialChars( $choose_text.' - '.$locale->getLanguageName( $locale ) ) ?>"
			><?= $choose_text ?></a>
		</div>
	</li>
<?php endforeach; ?>
</ul>