<?php

use Jet\UI_tabsJS_tab;
use Jet\MVC_View;

/**
 * @var MVC_View $this
 * @var UI_tabsJS_tab $t
 */
$t = $this->getRaw( 'element' );

if($t->getIsSelected()) {
	$t->setBaseCssClass('nav-link active');
	
} else {
	$t->setBaseCssClass('nav-link');
}

$t->setDataAttribute('toggle', 'tab');
$t->setCustomTagAttribute('href', '#'.$t->content()->getId());
$t->setCustomTagAttribute('role', 'tab');
$t->setCustomTagAttribute('aria-selected', $t->getIsSelected() ? 'true' : 'false');
$t->setCustomTagAttribute('aria-controls', $t->content()->getId());
// Roving tabindex per the APG tabs pattern: only the selected tab sits in the Tab
// order; arrow keys move among the others (see js/tabs-a11y.js).
$t->setCustomTagAttribute('tabindex', $t->getIsSelected() ? '0' : '-1');

?>
<li class="nav-item" role="presentation"><a <?=$t->renderTagAttributes()?>><?= $t->getTitle() ?></a></li>
